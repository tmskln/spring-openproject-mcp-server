ARG BUILD_IMAGE="ghcr.io/graalvm/native-image-community:25"
ARG MAVEN_IMAGE="docker.io/maven:3.9.11-eclipse-temurin-25"
ARG RUNTIME_IMAGE="docker.io/debian:bookworm-slim"

FROM ${MAVEN_IMAGE} AS maven

FROM ${BUILD_IMAGE} AS builder

WORKDIR /workspace

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    MAVEN_HOME=/usr/share/maven \
    PATH=/usr/share/maven/bin:${PATH}

COPY --from=maven /usr/share/maven /usr/share/maven
COPY pom.xml ./
COPY src/ src/

RUN mvn -B -Pnative -DskipTests clean native:compile

FROM ${RUNTIME_IMAGE}

LABEL org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.source="https://github.com/tmskln/spring-openproject-mcp-server.git" \
      org.opencontainers.image.description="MCP Server for OpenProject API (workpackages)"

WORKDIR /app

COPY --from=builder /workspace/target/spring-openproject-mcp-server app
COPY --from=builder /workspace/target/classes/application-prod.properties application-prod.properties
COPY --from=builder /workspace/target/classes/META-INF/sbom/application.cdx.json application.cdx.json
COPY --from=builder /workspace/target/classes/META-INF/sbom/application.spdx.json application.spdx.json

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates wget && \
    rm -rf /var/lib/apt/lists/* && \
    addgroup --system spring && \
    adduser --system --ingroup spring spring && \
    chown -R spring:spring /app

USER spring:spring

ENV SPRING_PROFILES_ACTIVE=prod

EXPOSE 8080

HEALTHCHECK --interval=5m --timeout=3s --start-period=20s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8081/actuator/health/readiness | grep -q '"status":"UP"' || exit 1

ENTRYPOINT ["sh", "-c", "exec /app/app --spring.profiles.active=${SPRING_PROFILES_ACTIVE}"]
