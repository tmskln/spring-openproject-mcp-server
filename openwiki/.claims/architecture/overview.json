          "version": "repo-file-v1:sha256:5e582eae0ec2eacf94547ca5b39fd67f75d9bc2ff73c05aa247409686893d1c9"
        },
        {
          "resource": "repo://src/main/java/de/tklein/tklab/openproject/mcp/openproject/client/OpenProjectConnectionResolver.java",
          "version": "repo-file-v1:sha256:7a9b212e5d14646307b6743de1206b99d6dec3b279c8ff01ccc19ee19d3df7b0"
        }
      ]
    },
    {
      "id": "claim_8473b4ce713d4feca8e346c39219bd06",
      "statement": "Spring Security configures two filter chains: actuatorSecurity (@Order(1)) protects /actuator/** with HTTP Basic auth for an admin user; mcpSecurity (@Order(2)) protects /mcp/**, /mcp, /error, and /sse with bearer-based authentication. The McpBearerAuthenticationFilter is explicitly registered inside the Spring Security chain via FilterRegistrationBean with setEnabled(false) to prevent global servlet filter registration.",
      "evidence": [
        {
          "resource": "repo://src/main/java/de/tklein/tklab/openproject/mcp/security/SecurityConfig.java",
          "version": "repo-file-v1:sha256:43463bc66cf6c35cd90f09baf25bb532bf7fe255500b9fd5bb05bb80c8c08841"
        }
      ]
    },
