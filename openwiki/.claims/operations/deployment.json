    {
      "id": "claim_3d9eb80fd61b4e11847cfa784357a90f",
      "statement": "User API tokens are never stored in the container. The OpenProjectTokenValidator validates tokens by calling GET /api/v3 on the OpenProject API and caches the result for 60 minutes using a Caffeine cache named 'auth-validation'. The cache key is a SHA-256 hash of 'baseUrl|token' — the raw token is never stored in the cache.",
      "evidence": [
