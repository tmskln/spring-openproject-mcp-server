    },
    {
      "id": "claim_21d49763aacf46489d2d116a7f76ca80",
      "statement": "The Dockerfile copies the application JAR as /app/app.jar, application-prod.properties to the image root, and both CycloneDX and SPDX SBOM files into the image. A non-root 'spring' system user is created and used at runtime.",
      "evidence": [
        {
          "resource": "repo://docker/Dockerfile#L9-L23",
          "version": "repo-lines-v1:sha256:517ad60fec47edb4f2fd2f8492db1a012a75efbfe9137eea873f54e482e958bb:"
