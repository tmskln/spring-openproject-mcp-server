    {
      "id": "claim_3a0fcbc3936f4b8985980e97a6db917c",
      "statement": "The actuator endpoint on port 8081 is secured with basic authentication: /actuator/health and /actuator/health/* are permitted without auth, while all other actuator paths require the ACTUATOR_ADMIN role. The default credentials are username 'admin' with a placeholder bcrypt hash.",
