    {
      "id": "claim_c097894547ab459e923652f867db9f21",
      "statement": "The 'prod' Spring Boot profile is activated at container start via the JVM system property -Dspring.profiles.active=prod, which overrides logging, actuator exposure, and enables Kubernetes-style health probes.",
