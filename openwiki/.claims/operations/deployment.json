    {
      "id": "claim_e9a447d8b6c94d169a698d1744c8c7da",
      "statement": "The Docker build produces a multi-platform image for linux/amd64 and linux/arm64 using the Eclipse Temurin JRE 25 base image (tag 25.0.4_7-jre-ubi10-minimal). An SBOM attestation is generated via docker/scout-sbom-indexer at build time.",
      "evidence": [
        {
